# Modelo de variáveis de ambiente (SEM VALORES). Nunca coloque valores reais neste arquivo nem no Git.
# Onde cada uma é configurada está indicado no comentário.

# --- Netlify (Site settings → Environment variables) e segredos do GitHub Actions ---
SUPABASE_URL=                 # Netlify + GitHub
SUPABASE_SERVICE_KEY=         # Netlify + GitHub (chave secreta: só no servidor)
STEAM_API_KEY=                # Netlify + GitHub
IGDB_CLIENT_ID=               # Netlify + GitHub
IGDB_CLIENT_SECRET=           # Netlify + GitHub
DEEPL_API_KEY=                # Netlify + GitHub (tradução)
ITAD_API_KEY=                 # Netlify (preços em todas as lojas)
VAPID_PUBLIC_KEY=             # Netlify (push)
VAPID_PRIVATE_KEY=            # Netlify (push)
VAPID_SUBJECT=                # Netlify, ex.: mailto:contato@...
PUSH_SECRET=                  # Netlify (o mesmo valor vai em settings.push no banco)
TURN_URL=                     # Netlify, ex.: turn:servidor:3478
TURN_SECRET=                  # Netlify (static-auth-secret do coturn)
CLOUDFLARE_TURN_KEY_ID=       # Netlify (opcional)
CLOUDFLARE_TURN_API_TOKEN=    # Netlify (opcional)
GITHUB_DISPARO_TOKEN=         # Netlify (botão "Postar no Instagram agora")
RATE_SAL=                     # Netlify (opcional: sal do hash do rate limit)
SITE_ORIGENS=                 # Netlify (opcional: origens extras permitidas, separadas por vírgula)

# --- Só no GitHub Actions ---
IG_USER_ID=
IG_TOKEN=
BACKUP_SENHA=                 # 16+ caracteres; sem ela o backup não roda

# --- Ponte do Discord (arquivo .env no PC que roda o Docker) ---
DISCORD_TOKEN=
SUPABASE_CHAVE_PUBLICA=       # a chave PÚBLICA (sb_publishable_...)
PONTES=
